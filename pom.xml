<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.datn.chatp2p</groupId>
  <artifactId>chat-p2p-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Chat P2P Java</name>
  <description>
    Ung dung chat ngang hang (P2P) ma hoa dau-cuoi tren nen tang Java.
    Xem De-cuong-Chat-P2P-Java.md va Phan-cong-cong-viec.md o thu muc goc.
  </description>

  <modules>
    <module>common</module>
    <module>crypto</module>
    <module>p2p-core</module>
    <module>signaling-server</module>
    <module>client-javafx</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <spring-boot.version>3.3.4</spring-boot.version>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.3</junit.version>
    <javafx.version>21.0.4</javafx.version>
    <!-- ice4j dung versioning kieu "git describe" (khong theo semver) - da kiem tra
         qua Maven Central API luc them dependency nay; kiem tra lai phien ban moi
         nhat tai https://search.maven.org/artifact/org.jitsi/ice4j truoc khi build
         neu qua lau sau thoi diem nay. -->
    <ice4j.version>3.2-8-gfa5f931</ice4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Cho phep signaling-server ke thua quan ly dependency cua Spring Boot
           ma khong bat buoc no la parent POM (parent da la POM cha cua toan repo). -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>

      <!-- Xuyen NAT (ICE/STUN/TURN) cho P2pDataChannel that - De-cuong-Chat-P2P-Java.md
           muc 5, Tai-lieu-ky-thuat.md Phan E.6. Chi dung o p2p-core. -->
      <dependency>
        <groupId>org.jitsi</groupId>
        <artifactId>ice4j</artifactId>
        <version>${ice4j.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- Module noi bo -->
      <dependency>
        <groupId>com.datn.chatp2p</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.datn.chatp2p</groupId>
        <artifactId>crypto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.datn.chatp2p</groupId>
        <artifactId>p2p-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
