<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.datn.chatp2p.client.view.HomeController"
      styleClass="home-root"
      spacing="16"
      alignment="CENTER">
    <padding>
        <Insets top="32" right="40" bottom="32" left="40"/>
    </padding>

    <Label text="Chat P2P Java" styleClass="app-title"/>
    <Label text="Chat ngang hang, ma hoa dau-cuoi, khong luu tren may chu"
           styleClass="app-subtitle" wrapText="true"/>

    <VBox spacing="6">
        <Label text="Ten hien thi cua ban"/>
        <TextField fx:id="userNameField" promptText="Vi du: Khoi"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Ten phong"/>
        <HBox spacing="8">
            <TextField fx:id="roomNameField" promptText="Nhap ten phong hoac bam Ngau nhien" HBox.hgrow="ALWAYS"/>
            <Button text="Ngau nhien" onAction="#onGenerateRoomName"/>
        </HBox>
    </VBox>

    <Button text="Tao / Tham gia phong" onAction="#onJoinRoom" styleClass="primary-button" defaultButton="true"/>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
</VBox>
