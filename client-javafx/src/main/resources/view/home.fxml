<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.datn.chatp2p.client.view.HomeController"
           styleClass="home-root">

    <VBox styleClass="home-card" spacing="18" maxWidth="700" maxHeight="-Infinity">
        <padding>
            <Insets top="30" right="32" bottom="28" left="32"/>
        </padding>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fth-send" styleClass="app-logo"/>
            <Label text="Chat P2P Java" styleClass="app-title"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fth-lock" styleClass="app-subtitle-icon"/>
            <Label text="Chat trực tiếp, mã hoá đầu-cuối, không lưu trên máy chủ" styleClass="app-subtitle"/>
        </HBox>

        <HBox spacing="18" styleClass="home-columns" alignment="TOP_CENTER">
            <VBox fx:id="createColumn" spacing="14" styleClass="room-create-column" prefWidth="290" maxWidth="300" HBox.hgrow="NEVER">
                <Label text="Bắt đầu cuộc trò chuyện" styleClass="column-title"/>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="identity-row">
                    <StackPane fx:id="avatarHolder"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Tên hiển thị của bạn" styleClass="field-label"/>
                        <TextField fx:id="userNameField" promptText="Ví dụ: Khôi"/>
                    </VBox>
                </HBox>

                <Button fx:id="createRoomButton" text="Tạo phòng" onAction="#onCreateRoom"
                        styleClass="accent, join-button" defaultButton="true" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-plus-circle"/></graphic>
                    <tooltip><Tooltip text="Tạo phòng mới: đặt tên phòng và (tuỳ chọn) mật khẩu"/></tooltip>
                </Button>
                <Button fx:id="joinByNameButton" text="Vào phòng bằng tên" onAction="#onJoinByName"
                        maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-log-in"/></graphic>
                    <tooltip><Tooltip text="Vào phòng bạn bè đã gửi tên (và mật khẩu nếu có)"/></tooltip>
                </Button>
                <Label text="Tạo phòng rồi gửi tên phòng (và mật khẩu, nếu đặt) cho bạn bè qua một kênh khác. Tên phòng và mật khẩu phân biệt hoa thường."
                       styleClass="field-hint" wrapText="true"/>
                <Label fx:id="joiningLabel" styleClass="field-hint" wrapText="true"/>
            </VBox>

            <VBox fx:id="roomBrowserBox" spacing="10" styleClass="room-browser-column" HBox.hgrow="ALWAYS">
                <Label text="Phòng đang hoạt động" styleClass="column-title"/>
                <TextField fx:id="roomSearchField" promptText="Tìm kiếm phòng..."/>
                <ListView fx:id="roomListView" prefHeight="200" VBox.vgrow="ALWAYS"/>
                <Label text="Bấm vào một phòng để vào. Phòng có biểu tượng ổ khoá cần mật khẩu."
                       styleClass="field-hint" wrapText="true"/>
                <Button text="Làm mới" onAction="#onRefreshRooms">
                    <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                </Button>
            </VBox>
        </HBox>

        <TitledPane text="Tuỳ chọn kết nối" expanded="false" styleClass="advanced-pane">
            <VBox spacing="8">
                <Label text="Địa chỉ signaling server" styleClass="field-label"/>
                <TextField fx:id="serverField" promptText="ws://địa-chỉ:8080"/>
            </VBox>
        </TitledPane>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
    </VBox>

    <Button fx:id="themeToggleButton" styleClass="button-icon, flat" StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="12" right="12"/>
        </StackPane.margin>
    </Button>
</StackPane>
