<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Bo cuc 3 cot: hoi thoai (trai) · khung chat (giua) · nguoi trong phong (phai).
     Cua so hep thi 2 cot ben tu an dan (RoomLayout) - khung chat luon giu cho; nut tren header mo lai. -->
<BorderPane fx:id="roomRoot"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.datn.chatp2p.client.view.RoomController"
            styleClass="room-root">

    <!-- ============ COT TRAI: phong + hoi thoai ============ -->
    <left>
        <VBox fx:id="sidebarPanel" styleClass="sidebar" prefWidth="260" minWidth="220">
            <VBox styleClass="sidebar-header" spacing="8">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <FontIcon fx:id="roomIcon" iconLiteral="fth-hash" styleClass="room-icon"/>
                    <Label fx:id="roomNameLabel" styleClass="room-name" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="roomDescriptionLabel" styleClass="room-description" wrapText="true"/>
                <Button text="Mời bạn bè" onAction="#onCopyRoomName" styleClass="invite-button">
                    <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
                    <tooltip><Tooltip text="Sao chép tên phòng để gửi cho bạn bè qua một kênh khác"/></tooltip>
                </Button>
            </VBox>

            <Label text="TRÒ CHUYỆN" styleClass="section-title, sidebar-section"/>
            <ListView fx:id="conversationListView" styleClass="conversation-list, edge-to-edge" VBox.vgrow="ALWAYS"/>

            <HBox styleClass="self-card" spacing="8" alignment="CENTER_LEFT">
                <StackPane fx:id="selfAvatarHolder"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS" minWidth="0">
                    <Label fx:id="selfNameLabel" styleClass="self-name"/>
                    <Label text="Bạn" styleClass="self-subtitle"/>
                </VBox>
                <Button onAction="#onOpenSettings" styleClass="button-icon, flat">
                    <graphic><FontIcon iconLiteral="fth-settings"/></graphic>
                    <tooltip><Tooltip text="Cài đặt: giao diện, âm báo, thông báo, danh tính"/></tooltip>
                </Button>
                <Button fx:id="themeToggleButton" styleClass="button-icon, flat"/>
                <Button onAction="#onLeaveRoom" styleClass="button-icon, flat, danger">
                    <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
                    <tooltip><Tooltip text="Rời phòng"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </left>

    <!-- ============ COT GIUA: khung chat ============ -->
    <center>
        <BorderPane styleClass="chat-panel">
            <top>
                <HBox styleClass="chat-header" spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="sidebarToggleButton" onAction="#onToggleSidebar"
                            styleClass="button-icon, flat, panel-toggle" visible="false" managed="false">
                        <graphic><FontIcon iconLiteral="fth-menu"/></graphic>
                        <tooltip><Tooltip text="Hiện / ẩn danh sách trò chuyện"/></tooltip>
                    </Button>
                    <FontIcon fx:id="chatTitleIcon" iconLiteral="fth-users" styleClass="chat-title-icon"/>
                    <Label fx:id="chatTitleLabel" text="Nhóm" styleClass="chat-title" minWidth="0"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox fx:id="statusChips" spacing="6" alignment="CENTER_RIGHT"/>
                    <Button fx:id="membersToggleButton" onAction="#onToggleMembers"
                            styleClass="button-icon, flat, panel-toggle">
                        <graphic><FontIcon iconLiteral="fth-sidebar"/></graphic>
                        <tooltip><Tooltip text="Hiện / ẩn người trong phòng"/></tooltip>
                    </Button>
                </HBox>
            </top>
            <center>
                <!-- Thanh tab bi an: danh sach hoi thoai ben trai chon tab -->
                <TabPane fx:id="chatTabs" tabClosingPolicy="UNAVAILABLE" styleClass="conversation-tabs">
                    <Tab text="Nhóm">
                        <content>
                            <StackPane>
                                <ListView fx:id="transcriptListView" styleClass="transcript, edge-to-edge"/>
                                <VBox fx:id="emptyState" styleClass="empty-state" spacing="10" alignment="CENTER"
                                      maxWidth="420" maxHeight="-Infinity" mouseTransparent="false">
                                    <FontIcon iconLiteral="fth-user-plus" styleClass="empty-state-icon"/>
                                    <Label text="Đang chờ người tham gia" styleClass="empty-state-title"/>
                                    <Label text="Phòng đã sẵn sàng để bắt đầu trò chuyện" styleClass="empty-state-kicker"/>
                                    <Label text="Gửi tên phòng dưới đây cho bạn bè qua một kênh khác. Khi họ vào phòng, kênh mã hoá đầu-cuối sẽ tự được thiết lập."
                                           styleClass="empty-state-text" wrapText="true" textAlignment="CENTER"/>
                                    <Label fx:id="emptyStateRoomLabel" styleClass="empty-state-room"/>
                                    <Button text="Sao chép tên phòng" onAction="#onCopyRoomName" styleClass="accent">
                                        <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
                                    </Button>
                                </VBox>
                            </StackPane>
                        </content>
                    </Tab>
                </TabPane>
            </center>
            <bottom>
                <VBox styleClass="message-input-bar" spacing="6">
                    <Label fx:id="typingLabel" styleClass="typing-indicator" visible="false" managed="false"/>
                    <HBox spacing="6" alignment="BOTTOM_CENTER" styleClass="composer">
                        <Button onAction="#onAttachFile" styleClass="button-icon, flat, attach-button">
                            <graphic><FontIcon iconLiteral="fth-paperclip"/></graphic>
                            <tooltip><Tooltip text="Gửi tệp (tối đa 100 MB) — hoặc kéo thả tệp vào khung chat"/></tooltip>
                        </Button>
                        <TextArea fx:id="messageArea" promptText="Nhắn tới Nhóm…" HBox.hgrow="ALWAYS"
                                  wrapText="true" prefRowCount="1" styleClass="message-area"/>
                        <Button onAction="#onSendMessage" styleClass="accent, button-icon, send-button">
                            <graphic><FontIcon iconLiteral="fth-send"/></graphic>
                            <tooltip><Tooltip text="Gửi (Enter)"/></tooltip>
                        </Button>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-lock" styleClass="input-hint-icon"/>
                        <Label text="Mã hoá trước khi rời máy  ·  Enter gửi, Shift+Enter xuống dòng  ·  **đậm** *nghiêng* `code`"
                               styleClass="input-hint"/>
                    </HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </center>

    <!-- ============ COT PHAI: nguoi trong phong + bao mat ============ -->
    <right>
        <VBox fx:id="membersPanel" styleClass="members-panel" prefWidth="270" minWidth="230">
            <Label fx:id="peerSectionLabel" styleClass="section-title, members-title"/>
            <ListView fx:id="peerListView" styleClass="peer-list, edge-to-edge" VBox.vgrow="ALWAYS"/>
            <VBox styleClass="security-card" spacing="7">
                <Label text="Bảo mật phòng" styleClass="security-card-title"/>
                <Label text="ECDH + AES-256-GCM, khoá riêng cho từng người" styleClass="security-line" wrapText="true">
                    <graphic><FontIcon iconLiteral="fth-lock"/></graphic>
                </Label>
                <Label fx:id="roomPasswordNote" styleClass="security-line" wrapText="true">
                    <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                </Label>
                <Label text="Máy chủ chỉ giới thiệu, không thấy nội dung" styleClass="security-line" wrapText="true">
                    <graphic><FontIcon iconLiteral="fth-server"/></graphic>
                </Label>
                <Label text="Qua relay vẫn mã hoá đầu-cuối" styleClass="security-line" wrapText="true">
                    <graphic><FontIcon iconLiteral="fth-shuffle"/></graphic>
                </Label>
            </VBox>
        </VBox>
    </right>
</BorderPane>
